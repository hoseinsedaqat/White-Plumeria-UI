{
  "name": "@white-plumeria/svelte",
  "version": "0.1.0",
  "description": "Svelte 5 components for White Plumeria. Pair with @white-plumeria/styles.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "author": "hoseinsedaqat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoseinsedaqat/White-Plumeria-UI.git",
    "directory": "packages/svelte"
  },
  "bugs": { "url": "https://github.com/hoseinsedaqat/White-Plumeria-UI/issues" },
  "keywords": ["white-plumeria", "svelte", "design-system"],
  "publishConfig": { "access": "public" },
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "svelte-package -i src/lib -o dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@white-plumeria/core": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "@white-plumeria/styles": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@white-plumeria/styles": { "optional": true }
  },
  "devDependencies": {
    "@sveltejs/package": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "catalog:",
    "svelte-check": "4.7.7",
    "typescript": "catalog:"
  }
}
