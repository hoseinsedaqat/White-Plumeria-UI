{
  "name": "@white-plumeria/mcp",
  "version": "0.1.0",
  "description": "MCP server for the White Plumeria catalog. It does not call a model.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "author": "hoseinsedaqat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoseinsedaqat/White-Plumeria-UI.git",
    "directory": "packages/mcp"
  },
  "bugs": { "url": "https://github.com/hoseinsedaqat/White-Plumeria-UI/issues" },
  "keywords": ["white-plumeria", "mcp", "design-system"],
  "publishConfig": { "access": "public" },
  "files": ["dist", "README.md"],
  "bin": {
    "white-plumeria-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@white-plumeria/core": "workspace:*",
    "@white-plumeria/tokens": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsdown": "0.23.2",
    "typescript": "catalog:"
  }
}
