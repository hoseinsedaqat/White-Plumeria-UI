import { treeExpandAction } from "@white-plumeria/core";
import { emit } from "../emit.ts";
import Branch from "./tree-branch.marko";

export interface Node {
  id: string;
  label: string;
  children?: Node[];
}

export interface Input {
  label?: string;
  nodes?: Node[];
  onSelect?: (id: string) => void;
}

<let/open=[]>
<let/selected="">
<ul/host class="wpl-tree" role="tree" aria-label=input.label || "Tree">
  <Branch
    nodes=input.nodes
    open=open
    selected=selected
    onPick=(id) => {
      selected = id;
      emit(host(), "wpl-select", { id });
      input.onSelect?.(id);
    }
    onToggle=(id) => {
      open = open.includes(id) ? open.filter((item) => item !== id) : open.concat(id);
    }
    onKey=(event, id, hasChildren) => {
      if (!hasChildren) return;
      const expanded = open.includes(id);
      const action = treeExpandAction(event.key, host(), expanded);
      if (!action) return;
      event.preventDefault();
      if (action === "stay") return;
      open = action === "open" ? open.concat(id) : open.filter((item) => item !== id);
    }
  />
</ul>
