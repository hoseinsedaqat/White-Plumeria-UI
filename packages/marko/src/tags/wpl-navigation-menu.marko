export interface Item { href?: string; label: string; current?: boolean; }
export interface Input { label?: string; items?: Item[]; }
<nav aria-label=input.label || "Navigation">
  <ul class="wpl-nav-menu">
    <for|item| of=(input.items ?? [])>
      <li><a class="wpl-nav-link" href=item.href || "#" aria-current=(item.current ? "page" : null)>${item.label}</a></li>
    </for>
  </ul>
</nav>
