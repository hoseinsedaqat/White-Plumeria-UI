import { firstEnabledIndex, menuCommand, menuHasSubmenu, moveEnabledIndex, readingDirection, typeaheadMove } from "@white-plumeria/core";
import { emit } from "../emit.ts";

export interface Item {
  id: string;
  label: string;
  disabled?: boolean;
  items?: Item[];
}

export interface Input {
  items?: Item[];
  label?: string;
  content?: Marko.Body;
  onSelect?: (id: string) => void;
}

<let/point=(null as { x: number; y: number } | null)>
<let/active=0>
<let/sub=(null as number | null)>
<let/typeahead={ query: "", at: 0 }>
<const/items=input.items ?? []>
<const/parent=items[active]>
<const/children=parent?.items ?? []>
<const/current=sub === null ? parent : children[sub]>
<id/menuId/>

<div/host
  class="wpl-context"
  tabindex="0"
  aria-label=input.label || "Context menu"
  aria-controls=(point ? menuId : null)
  aria-activedescendant=(point && current ? `${menuId}-${current.id}` : null)
  onContextMenu(event) {
    event.preventDefault();
    point = { x: event.clientX, y: event.clientY };
    active = firstEnabledIndex(items);
    sub = null;
    host().focus();
  }
  onKeyDown(event) {
    if (event.key === "F10" && event.shiftKey) {
      event.preventDefault();
      const rect = host().getBoundingClientRect();
      point = { x: rect.left, y: rect.bottom };
      active = firstEnabledIndex(items);
      sub = null;
      return;
    }
    if (!point) return;
    const command = menuCommand({
      key: event.key,
      direction: readingDirection(host()),
      open: true,
      submenuOpen: sub !== null,
      hasSubmenu: menuHasSubmenu(current),
    });
    if (!command) {
      const pool = sub === null ? items : children;
      const from = sub === null ? active : sub;
      const next = typeaheadMove(typeahead, pool, event.key, Date.now(), from);
      if (next === null) return;
      event.preventDefault();
      if (sub === null) active = next;
      else sub = next;
      return;
    }
    if (command === "open") return;
    event.preventDefault();
    if (command === "close") {
      point = null;
      sub = null;
      return;
    }
    if (command === "close-submenu") {
      sub = null;
      return;
    }
    if (command === "open-submenu") {
      if (menuHasSubmenu(parent)) sub = firstEnabledIndex(parent.items);
      return;
    }
    if (command === "activate") {
      if (current && !current.disabled && !menuHasSubmenu(current)) {
        point = null;
        sub = null;
        emit(host(), "wpl-select", { id: current.id });
        input.onSelect?.(current.id);
      }
      return;
    }
    if (sub === null) active = moveEnabledIndex(items, active, command);
    else sub = moveEnabledIndex(children, sub, command);
  }
>
  <${input.content}/>
  <if=point>
    <div class="wpl-menu wpl-menu-panel" id=menuId role="menu" aria-label=input.label || "Context menu">
      <for|item, index| of=items>
        <div class="wpl-menu-row">
          <button
            type="button"
            id=`${menuId}-${item.id}`
            class="wpl-menu-item"
            role="menuitem"
            disabled=item.disabled
            aria-haspopup=menuHasSubmenu(item) ? "menu" : undefined
            aria-expanded=(menuHasSubmenu(item) ? String(sub !== null && index === active) : null)
            aria-controls=(sub !== null && index === active && menuHasSubmenu(item) ? `${menuId}-sub-${item.id}` : null)
            data-active=(sub === null && index === active ? "true" : null)
            onClick() {
              if (item.disabled) return;
              if (menuHasSubmenu(item)) {
                active = index;
                sub = firstEnabledIndex(item.items ?? []);
                return;
              }
              point = null;
              sub = null;
              emit(host(), "wpl-select", { id: item.id });
              input.onSelect?.(item.id);
            }
          >
            ${item.label}
          </button>
          <if=sub !== null && index === active && menuHasSubmenu(item)>
            <div id=`${menuId}-sub-${item.id}` class="wpl-menu-sub" role="menu" aria-label=item.label>
              <for|child, childIndex| of=item.items ?? []>
                <button
                  type="button"
                  id=`${menuId}-${child.id}`
                  class="wpl-menu-item"
                  role="menuitem"
                  disabled=child.disabled
                  data-active=(childIndex === sub ? "true" : null)
                  onClick() {
                    if (child.disabled) return;
                    point = null;
                    sub = null;
                    emit(host(), "wpl-select", { id: child.id });
                    input.onSelect?.(child.id);
                  }
                >${child.label}</button>
              </for>
            </div>
          </if>
        </div>
      </for>
    </div>
  </if>
</div>
