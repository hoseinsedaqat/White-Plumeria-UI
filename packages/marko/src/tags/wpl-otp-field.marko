import { formatNumber, otpApply, otpCells, otpDelete, otpLength } from "@white-plumeria/core";
import { emit } from "../emit.ts";
import { activeLocale, text } from "../text.ts";

export interface Input {
  label?: string;
  value?: string;
  length?: number;
  numeric?: boolean;
  name?: string;
  onChange?: (value: string) => void;
}

<let/value=input.value ?? "">
<const/length=otpLength(Number(input.length) || 6)>
<const/numeric=input.numeric !== false>
<const/cells=otpCells(value, length, numeric)>
<id/labelId/>

static function focusCell(host: HTMLElement | null, index: number) {
  const cell = host?.querySelectorAll("input.wpl-otp-cell")[index];
  if (cell instanceof HTMLElement) cell.focus();
}

<div class="wpl-field">
  <span class="wpl-label" id=labelId>${input.label || "Code"}</span>
  <div/host class="wpl-otp" role="group" aria-labelledby=labelId>
    <for|cell, index| of=cells>
      <input
        class="wpl-input wpl-otp-cell"
        inputmode=(numeric ? "numeric" : "text")
        maxlength="1"
        autocomplete=(index === 0 ? "one-time-code" : "off")
        aria-label=`${text("character")} ${formatNumber(index + 1, activeLocale())} ${text("of")} ${formatNumber(length, activeLocale())}`
        value=cell
        onInput(event) {
          const incoming = event.target instanceof HTMLInputElement ? event.target.value : "";
          const next = otpApply(value, length, numeric, index, incoming);
          value = next.value;
          emit(host(), "wpl-change", { value });
          input.onChange?.(value);
          focusCell(host(), next.focus);
        }
        onPaste(event) {
          event.preventDefault();
          const record = event as Event & { clipboardData?: { getData: (type: string) => string } };
          const incoming = record.clipboardData?.getData("text") ?? "";
          const next = otpApply(value, length, numeric, index, incoming);
          value = next.value;
          emit(host(), "wpl-change", { value });
          input.onChange?.(value);
          focusCell(host(), next.focus);
        }
        onKeyDown(event) {
          if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
            event.preventDefault();
            focusCell(host(), index + (event.key === "ArrowRight" ? 1 : -1));
            return;
          }
          if (event.key !== "Backspace" || cell) return;
          event.preventDefault();
          const next = otpDelete(value, length, numeric, index);
          value = next.value;
          emit(host(), "wpl-change", { value });
          input.onChange?.(value);
          focusCell(host(), next.focus);
        }
      />
    </for>
  </div>
  <if=input.name><input type="hidden" name=input.name value=value/></if>
</div>
<script>
  const parts = otpCells(value, length, numeric);
  host()?.querySelectorAll("input.wpl-otp-cell").forEach((node, item) => {
    if (node instanceof HTMLInputElement && node.value !== (parts[item] ?? "")) node.value = parts[item] ?? "";
  });
</script>
