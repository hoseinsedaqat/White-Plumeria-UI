import { mountProvider } from "../provider.ts";
import { enterLocale, leaveLocale, leaveOnServer } from "../text.ts";

export interface Input {
  theme?: string;
  appearance?: "light" | "dark" | "system";
  locale?: "en" | "fa";
  direction?: "ltr" | "rtl" | "auto";
  persist?: boolean;
  content?: Marko.Body;
}

<const/locale=enterLocale(input.locale)>
<div/host class="wpl-root wpl-reset wpl-provider" data-wpl-provider data-wpl-locale=locale>
  <${input.content}/>
  <div class="wpl-toast-region" data-wpl-toasts role="region" aria-live="polite" data-wpl-locale-scope=leaveOnServer()></div>
  <lifecycle
    onMount() {
      leaveLocale();
      return { stop: mountProvider(host(), input) };
    }
    onDestroy() {
      this.stop?.();
    }
  />
</div>
