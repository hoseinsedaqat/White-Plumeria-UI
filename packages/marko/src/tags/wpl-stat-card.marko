export interface Input { label?: string; value?: string | number; hint?: string; }
<article class="wpl-card wpl-stat">
  <p class="wpl-stat-label">${input.label || "Stat"}</p>
  <p class="wpl-stat-value">${input.value ?? "0"}</p>
  <if=input.hint><p class="wpl-stat-hint">${input.hint}</p></if>
</article>
