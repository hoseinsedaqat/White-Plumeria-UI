import { emit } from "../emit.ts";
import { iconPaths } from "@white-plumeria/core";
import { text } from "../text.ts";
export interface Input { label?: string; value?: string; placeholder?: string; visuallyHiddenLabel?: boolean; onChange?: (value: string) => void; onSearch?: (value: string) => void; }
<let/value=input.value ?? "">
<id/fieldId/>
<div/host class="wpl-search">
  <label class=(input.visuallyHiddenLabel ? "wpl-label wpl-sr-only" : "wpl-label") for=fieldId>${input.label || text("search")}</label>
  <div class="wpl-search-control">
    <span class="wpl-search-icon" aria-hidden="true">
      <svg class="wpl-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d=iconPaths.search/></svg>
    </span>
    <input id=fieldId class="wpl-input" type="search" placeholder=input.placeholder || text("search") value=value valueChange(next) { value = String(next); emit(host(), "wpl-change", { value }); input.onChange?.(value); } onKeyDown(event) { if (event.key === "Enter") { emit(host(), "wpl-search", { value }); input.onSearch?.(value); } }>
    <if=value>
      <button type="button" class="wpl-icon-btn wpl-icon-btn-sm wpl-btn-ghost wpl-search-clear" aria-label=text("clear") onClick() { value = ""; emit(host(), "wpl-change", { value: "" }); input.onChange?.(""); }>
        <svg class="wpl-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d=iconPaths.close/></svg>
      </button>
    </if>
  </div>
</div>
