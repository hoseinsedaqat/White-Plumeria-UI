import { formatNumber } from "@white-plumeria/core";
import { activeLocale } from "../text.ts";

export interface Point { label?: string; value?: number; }
export interface Input {
  title?: string;
  label?: string;
  description?: string;
  data?: Point[];
  content?: Marko.Body;
}

<const/title=input.title || input.label || "Chart">
<const/points=Array.isArray(input.data) ? input.data : []>
<const/invalid=points.some((point) => !Number.isFinite(Number(point.value)) || Number(point.value) < 0)>
<const/max=Math.max(1, ...points.map((point) => Number(point.value)))>
<const/locale=activeLocale()>

<figure class="wpl-chart">
  <figcaption class="wpl-card-title">${title}</figcaption>
  <if=input.description><p class="wpl-muted">${input.description}</p></if>
  <if=invalid>
    <p class="wpl-field-error" role="alert">ChartContainer accepts finite, non-negative values only.</p>
  </if>
  <else>
    <div aria-hidden="true">
      <for|point| of=points>
        <div class="wpl-chart-bar">
          <span>${point.label}</span>
          <span class="wpl-chart-track"><span class="wpl-chart-fill" style=`inline-size:${(Number(point.value) / max) * 100}%`></span></span>
          <span>${formatNumber(Number(point.value), locale)}</span>
        </div>
      </for>
    </div>
  </else>
  <if=input.content><${input.content}/></if>
  <table class="wpl-table wpl-chart-table">
    <caption class="wpl-sr-only">${title}</caption>
    <thead><tr><th scope="col">Label</th><th scope="col">Value</th></tr></thead>
    <tbody>
      <for|point| of=points>
        <tr>
          <th scope="row">${point.label}</th>
          <td>${Number.isFinite(Number(point.value)) ? formatNumber(Number(point.value), locale) : String(point.value)}</td>
        </tr>
      </for>
    </tbody>
  </table>
</figure>
