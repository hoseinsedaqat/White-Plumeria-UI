export interface Item { id?: string; title?: string; label?: string; description?: string; meta?: string; }
export interface Input { items?: Item[]; }
<ul class="wpl-list">
  <for|item| of=(input.items ?? [])>
    <li class="wpl-list-item">
      <div>
        <p class="wpl-timeline-title">${item.title || item.label}</p>
        <if=item.description><p class="wpl-timeline-body">${item.description}</p></if>
      </div>
      <if=item.meta><span class="wpl-muted">${item.meta}</span></if>
    </li>
  </for>
</ul>
