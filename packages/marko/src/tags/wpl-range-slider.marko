import { normalizeRange, rangeBounds } from "@white-plumeria/core";
import { emit } from "../emit.ts";
export interface Input { label?: string; min?: number; max?: number; step?: number; start?: number; end?: number; onChange?: (value: { start: number; end: number }) => void; }
<const/bounds=rangeBounds(Number(input.min ?? 0), Number(input.max ?? 100), Number(input.step ?? 1))>
<const/label=input.label || "Range">
<let/start=Number(input.start ?? bounds.min)>
<let/end=Number(input.end ?? bounds.max)>
<div/host class="wpl-field">
  <div class="wpl-flex wpl-flex-between">
    <span class="wpl-label">${label}</span>
    <output class="wpl-range-readout" aria-hidden="true">${start} – ${end}</output>
  </div>
  <input class="wpl-slider" type="range" min=bounds.min max=bounds.max step=bounds.step value=start aria-label=`${label} start` valueChange(next) { const ordered = normalizeRange(Number(next), end, bounds); start = ordered.start; end = ordered.end; emit(host(), "wpl-change", { start, end }); input.onChange?.({ start, end }); }>
  <input class="wpl-slider" type="range" min=bounds.min max=bounds.max step=bounds.step value=end aria-label=`${label} end` valueChange(next) { const ordered = normalizeRange(start, Number(next), bounds); start = ordered.start; end = ordered.end; emit(host(), "wpl-change", { start, end }); input.onChange?.({ start, end }); }>
</div>
