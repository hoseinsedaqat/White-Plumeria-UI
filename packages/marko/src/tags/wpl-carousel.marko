import { canMove, moveIndex } from "@white-plumeria/core";
import { emit } from "../emit.ts";

export interface Slide {
  id?: string;
  label?: string;
  content?: string;
  src?: string;
  alt?: string;
  caption?: string;
}

export interface Input {
  label?: string;
  slides?: Slide[];
  index?: number;
  loop?: boolean;
  onIndexChange?: (index: number) => void;
}

<let/index=Number.isFinite(input.index) ? Number(input.index) : 0>
<const/slides=input.slides ?? []>
<const/slide=slides[index]>

<div/host class="wpl-carousel" aria-roledescription="carousel" aria-label=input.label || "Carousel" data-index=index>
  <div class="wpl-carousel-bar">
    <button
      type="button"
      class="wpl-carousel-control"
      aria-label="Previous"
      disabled=!canMove(index, -1, slides.length, Boolean(input.loop))
      onClick() {
        index = moveIndex(index, -1, slides.length, Boolean(input.loop));
        emit(host(), "wpl-change", { index });
        input.onIndexChange?.(index);
      }
    >‹</button>
    <div class="wpl-carousel-viewport">
      <div class="wpl-carousel-slide" aria-label=slide?.label>
        <if=slide?.src>
          <figure class="wpl-carousel-figure">
            <img class="wpl-carousel-image" src=slide.src alt=slide.alt || slide.label || "">
            <figcaption class="wpl-carousel-caption">
              <strong>${slide.label || ""}</strong>
              <if=slide.caption><span>${slide.caption}</span></if>
            </figcaption>
          </figure>
        </if>
        <if=slide?.content><div class="wpl-carousel-copy">${slide.content}</div></if>
        <if=!slide?.src && !slide?.content><p class="wpl-carousel-copy">${slide?.label || ""}</p></if>
      </div>
    </div>
    <button
      type="button"
      class="wpl-carousel-control"
      aria-label="Next"
      disabled=!canMove(index, 1, slides.length, Boolean(input.loop))
      onClick() {
        index = moveIndex(index, 1, slides.length, Boolean(input.loop));
        emit(host(), "wpl-change", { index });
        input.onIndexChange?.(index);
      }
    >›</button>
  </div>
</div>
