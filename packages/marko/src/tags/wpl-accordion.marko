import { iconPaths } from "@white-plumeria/core";
import { emit } from "../emit.ts";

export interface AccordionItem {
  id: string;
  title: string;
  content?: string;
}

export interface Input {
  items?: AccordionItem[];
  multiple?: boolean;
  value?: string[];
  onValueChange?: (value: string[]) => void;
}

<let/open=(input.value ?? [])>
<const/items=input.items ?? []>
<id/baseId/>

<div/host class="wpl-accordion">
  <for|item| of=items>
    <div class="wpl-accordion-item">
      <h3 style="margin: 0; font: inherit">
        <button
          type="button"
          class="wpl-accordion-trigger"
          id=`${baseId}-trigger-${item.id}`
          aria-expanded=String(open.includes(item.id))
          aria-controls=`${baseId}-${item.id}`
          onClick() {
            const has = open.includes(item.id);
            open = input.multiple
              ? (has ? open.filter((id) => id !== item.id) : open.concat(item.id))
              : (has ? [] : [item.id]);
            emit(host(), "wpl-change", { value: open });
            input.onValueChange?.(open);
          }
        >${item.title}<svg class=(open.includes(item.id) ? "wpl-icon" : "wpl-icon wpl-icon-dir") viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d=(open.includes(item.id) ? iconPaths.chevronDown : iconPaths.chevronRight)/></svg></button>
      </h3>
      <div id=`${baseId}-${item.id}` class="wpl-accordion-panel" role="region" aria-labelledby=`${baseId}-trigger-${item.id}` hidden=!open.includes(item.id)>${item.content || ""}</div>
    </div>
  </for>
</div>
