{
  "name": "@white-plumeria/qwik",
  "version": "0.1.0",
  "description": "Qwik components for White Plumeria. Pair with @white-plumeria/styles.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "author": "hoseinsedaqat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoseinsedaqat/White-Plumeria-UI.git",
    "directory": "packages/qwik"
  },
  "homepage": "https://github.com/hoseinsedaqat/White-Plumeria-UI/tree/test/packages/qwik#readme",
  "bugs": {
    "url": "https://github.com/hoseinsedaqat/White-Plumeria-UI/issues"
  },
  "keywords": ["white-plumeria", "qwik", "design-system", "accessible"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md"],
  "main": "./dist/index.qwik.mjs",
  "qwik": "./dist/index.qwik.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.qwik.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build --mode lib && tsc -p tsconfig.emit.json --pretty false",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@white-plumeria/core": "workspace:*"
  },
  "peerDependencies": {
    "@qwik.dev/core": "^2.0.0-rc.4",
    "@white-plumeria/styles": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@white-plumeria/styles": {
      "optional": true
    }
  },
  "devDependencies": {
    "@qwik.dev/core": "catalog:",
    "happy-dom": "21.0.4",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
