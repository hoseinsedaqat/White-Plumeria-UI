{
  "name": "@white-plumeria/cli",
  "version": "0.1.0",
  "description": "Install and inspect White Plumeria without copying component source.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "author": "hoseinsedaqat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoseinsedaqat/White-Plumeria-UI.git",
    "directory": "packages/cli"
  },
  "bugs": { "url": "https://github.com/hoseinsedaqat/White-Plumeria-UI/issues" },
  "keywords": ["white-plumeria", "cli", "design-system"],
  "publishConfig": { "access": "public" },
  "files": ["dist", "README.md"],
  "bin": { "wpl": "./dist/bin.js" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@white-plumeria/core": "workspace:*",
    "@white-plumeria/tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsdown": "0.23.2",
    "typescript": "catalog:"
  }
}
