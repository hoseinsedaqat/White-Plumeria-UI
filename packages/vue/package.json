{
  "name": "@white-plumeria/vue",
  "version": "0.1.0",
  "description": "Vue components for White Plumeria. Pair with @white-plumeria/styles.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "author": "hoseinsedaqat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoseinsedaqat/White-Plumeria-UI.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/hoseinsedaqat/White-Plumeria-UI/tree/test/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/hoseinsedaqat/White-Plumeria-UI/issues"
  },
  "keywords": ["white-plumeria", "vue", "design-system", "accessible"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@white-plumeria/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "@white-plumeria/styles": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@white-plumeria/styles": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "0.23.2",
    "typescript": "catalog:",
    "vue": "catalog:"
  }
}
