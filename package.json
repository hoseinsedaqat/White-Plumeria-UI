{
  "name": "white-plumeria",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "White Plumeria — a framework-agnostic design system for HTML, React, Vue, Svelte, Angular, Solid, Preact, Qwik, Lit, and Alpine.",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "pnpm --filter @white-plumeria/angular... build && pnpm --filter @white-plumeria/solid test && pnpm --filter @white-plumeria/preact test && pnpm --filter @white-plumeria/qwik test && pnpm --filter @white-plumeria/lit test && pnpm --filter @white-plumeria/alpine test && vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "dev": "pnpm --filter @white-plumeria/docs dev",
    "docs:build": "pnpm --filter @white-plumeria/docs build",
    "docs:preview": "pnpm --filter @white-plumeria/docs preview",
    "generate:tokens": "node scripts/generate-tokens-css.mjs",
    "generate:llms": "node scripts/generate-llms.mjs",
    "pack:dry-run": "node scripts/pack-dry-run.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "size": "node scripts/report-size.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/vue": "8.1.0",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svelte": "catalog:",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "turbo": "2.11.10",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue": "3.5.44"
  }
}
